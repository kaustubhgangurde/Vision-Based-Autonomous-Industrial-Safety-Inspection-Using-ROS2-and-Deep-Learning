<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="burger_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Industrial Facility Outer Enclosure Walls (12m x 12m Plant Boundary) -->
    <model name="enclosure_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="box_walls">
        <collision name="n_col"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></collision>
        <visual name="n_vis"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></visual>

        <collision name="s_col"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></collision>
        <visual name="s_vis"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></visual>

        <collision name="e_col"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>12 0.1 1</size></box></geometry></collision>
        <visual name="e_vis"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>12 0.1 1</size></box></geometry></visual>

        <collision name="w_col"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>12 0.1 1</size></box></geometry></collision>
        <visual name="w_vis"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>12 0.1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Industrial Equipment & Storage Racks -->
    <model name="storage_rack_east">
      <static>true</static>
      <pose>3.2 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.2 1.0</size></box></geometry>
          <material><ambient>0.1 0.4 0.6 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="storage_rack_west">
      <static>true</static>
      <pose>-3.2 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.2 1.0</size></box></geometry>
          <material><ambient>0.1 0.4 0.6 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="heavy_machinery_south">
      <static>true</static>
      <pose>0.0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.0 1.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Distributed Industrial Safety Hazards -->
    <model name="fire_hazard_barrel">
      <static>true</static>
      <pose>2.5 -1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chemical_leak_spill">
      <static>true</static>
      <pose>0.0 3.5 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.7</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.7</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pathway_blockage_box">
      <static>true</static>
      <pose>-2.8 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.9 0.4 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
